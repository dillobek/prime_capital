JWT_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_API_URL=https://api.primecapital.uz/api/v1
API_URL=http://backend:4000/api/v1
CORS_ORIGINS=https://primecapital.uz,https://www.primecapital.uz,https://web.primecapital.uz,https://ser.primecapital.uz
# Har bootda admin login/parolini shu qiymatlarga moslab qo'yadi (parolni almashtirish uchun shu yerni o'zgartirib konteynerni qayta ishga tushiring).
ADMIN_EMAIL=admin@primecapital.uz
ADMIN_PASSWORD=replace-with-a-very-strong-password
# Mobil ilovadagi telefon+OTP kirish uchun Eskiz.uz hisobi (https://eskiz.uz).
# Bo'sh qoldirilsa /auth/otp/request xatolik qaytaradi (SMS xizmati sozlanmagan).
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Ixtiyoriy: SMS jo'natuvchi nom/raqam. Test hisoblar uchun standart "4546" ishlaydi;
# ishlab chiqarishda o'z alfa-nomingizni Eskiz orqali tasdiqlatgandan keyin shu yerga yozing.
ESKIZ_FROM=4546
# Ixtiyoriy: OTP matn shabloni, {code} kod bilan almashtiriladi.
# ESLATMA: test (sandbox) Eskiz hisobida SMS faqat "This is test from Eskiz" matni bilan
# ketadi — bu Eskiz tomonidagi cheklov, boshqacha matn productionda shablon tasdiqlangandan keyin ishlaydi.
ESKIZ_OTP_TEMPLATE=Prime Capital ilovasiga kirish uchun bir martalik kod: {code} KODNI HECH KIMGA BERMANG.
